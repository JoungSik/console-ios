{
  "settings": {},
  "rules": [
    {
      "patterns": [
        "/new$",
        "/edit$"
      ],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "^/session/new$",
        "^/registration/new$",
        "^/passwords"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "^/$"
      ],
      "properties": {
        "presentation": "clear_all"
      }
    }
  ]
}
